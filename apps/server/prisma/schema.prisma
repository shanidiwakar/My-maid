generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum UserRole {
  CUSTOMER
  PARTNER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum OtpPurpose {
  LOGIN
  REGISTER
  RESET_PASSWORD
}

enum AddressType {
  HOME
  OFFICE
  OTHER
}

model User {
  id          String     @id @default(cuid())
  phone       String     @unique
  role        UserRole   @default(CUSTOMER)
  status      UserStatus @default(ACTIVE)
  isVerified  Boolean    @default(false)
  lastLoginAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  profile       UserProfile?
  refreshTokens RefreshToken[]

  addresses Address[]

  @@index([role])
  @@index([status])
}

model UserProfile {
  id     String @id @default(cuid())
  userId String @unique

  firstName    String
  lastName     String?
  email        String?
  gender       Gender?
  dob          DateTime?
  avatar       String?
  language     String    @default("en")
  referralCode String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique
  expiresAt  DateTime
  deviceId   String?
  deviceName String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpVerification {
  id         String     @id @default(cuid())
  phone      String
  otp        String
  purpose    OtpPurpose
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([phone, purpose])
}

model Address {
  id            String @id @default(cuid())

  userId        String
  cityId        String
  serviceAreaId String

  type          AddressType

  label         String?

  houseNumber   String
  buildingName  String?
  landmark      String?

  addressLine1  String
  addressLine2  String?

  pincode       String

  latitude      Decimal @db.Decimal(10, 7)
  longitude     Decimal @db.Decimal(10, 7)

  isDefault     Boolean @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  city City @relation(fields: [cityId], references: [id])

  serviceArea ServiceArea @relation(fields: [serviceAreaId], references: [id])

  @@index([userId])
  @@index([cityId])
  @@index([serviceAreaId])
}

model City {
  id       String  @id @default(cuid())
  name     String
  state    String
  country  String
  isActive Boolean @default(true)

  serviceAreas ServiceArea[]
  addresses Address[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, state])
}

model ServiceArea {
  id       String  @id @default(cuid())
  cityId   String
  name     String
  pincode  String
  isActive Boolean @default(true)

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)
  addresses Address[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cityId])
}

model AppConfiguration {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}
