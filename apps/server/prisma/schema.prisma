generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String     @id @default(cuid())
  phone       String     @unique
  role        UserRole   @default(CUSTOMER)
  status      UserStatus @default(ACTIVE)
  isVerified  Boolean    @default(false)
  lastLoginAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  addresses Address[]
  bookings  Booking[]

  customer Customer?
  partner  Partner?

  refreshTokens RefreshToken[]
  profile       UserProfile?

  @@index([role])
  @@index([status])
}

model UserProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  firstName    String
  lastName     String?
  email        String?
  gender       Gender?
  dob          DateTime?
  avatar       String?
  language     String    @default("en")
  referralCode String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Customer {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique
  expiresAt  DateTime
  deviceId   String?
  deviceName String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpVerification {
  id         String     @id @default(cuid())
  phone      String
  otp        String
  purpose    OtpPurpose
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([phone, purpose])
}

model Address {
  id            String      @id @default(cuid())
  userId        String
  cityId        String
  serviceAreaId String
  type          AddressType
  label         String?
  houseNumber   String
  buildingName  String?
  landmark      String?
  addressLine1  String
  addressLine2  String?
  pincode       String
  latitude      Decimal     @db.Decimal(10, 7)
  longitude     Decimal     @db.Decimal(10, 7)
  isDefault     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  city          City        @relation(fields: [cityId], references: [id])
  serviceArea   ServiceArea @relation(fields: [serviceAreaId], references: [id])
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings      Booking[]

  @@index([userId])
  @@index([cityId])
  @@index([serviceAreaId])
}

model City {
  id           String        @id @default(cuid())
  name         String
  state        String
  country      String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  addresses    Address[]
  partners     Partner[]
  serviceAreas ServiceArea[]

  @@unique([name, state])
}

model ServiceArea {
  id        String    @id @default(cuid())
  cityId    String
  name      String
  pincode   String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  addresses Address[]
  partners  Partner[]
  city      City      @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, name])
  @@index([cityId])
}

model ServiceCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  image       String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  services    Service[]
}

model Service {
  id              String           @id @default(cuid())
  categoryId      String
  name            String
  slug            String           @unique
  description     String?
  image           String?
  basePrice       Decimal          @db.Decimal(10, 2)
  duration        Int
  rating          Float            @default(0)
  reviewCount     Int              @default(0)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  bookings        Booking[]
  partnerServices PartnerService[]
  category        ServiceCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model Booking {
  id              String        @id @default(cuid())
  bookingNumber   String        @unique
  userId          String
  serviceId       String
  addressId       String
  partnerId       String?
  bookingDate     DateTime
  slotStart       DateTime
  slotEnd         DateTime
  quantity        Int           @default(1)
  serviceName     String
  serviceDuration Int
  unitPrice       Decimal       @db.Decimal(10, 2)
  totalPrice      Decimal       @db.Decimal(10, 2)
  discount        Decimal       @default(0) @db.Decimal(10, 2)
  finalAmount     Decimal       @db.Decimal(10, 2)
  houseNumber     String
  buildingName    String?
  addressLine1    String
  addressLine2    String?
  landmark        String?
  cityName        String
  serviceAreaName String
  pincode         String
  notes           String?
  status          BookingStatus @default(PENDING)
  cancelledReason String?

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  address         Address       @relation(fields: [addressId], references: [id])
  partner         Partner?      @relation(fields: [partnerId], references: [id])
  service         Service       @relation(fields: [serviceId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([bookingDate])
}

model Partner {
  id              String              @id @default(cuid())
  userId          String              @unique
  experience      Int                 @default(0)
  rating          Decimal             @default(0) @db.Decimal(3, 2)
  totalJobs       Int                 @default(0)
  isVerified      Boolean             @default(false)
  status          PartnerStatus       @default(PENDING)
  availability    PartnerAvailability @default(OFFLINE)
  cityId          String
  serviceAreaId   String

  latitude          Decimal?            @db.Decimal(10, 7)
  longitude         Decimal?            @db.Decimal(10, 7)
  locationUpdatedAt DateTime?

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  bookings        Booking[]
  city            City                @relation(fields: [cityId], references: [id])
  serviceArea     ServiceArea         @relation(fields: [serviceAreaId], references: [id])
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  partnerServices PartnerService[]

  @@index([status])
  @@index([availability])
  @@index([cityId])
  @@index([serviceAreaId])
}

model PartnerService {
  partnerId String
  serviceId String
  createdAt DateTime @default(now())
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([partnerId, serviceId])
  @@index([serviceId])
}

model AppConfiguration {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum UserRole {
  CUSTOMER
  PARTNER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum OtpPurpose {
  LOGIN
  REGISTER
  RESET_PASSWORD
}

enum AddressType {
  HOME
  OFFICE
  OTHER
}

enum PartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum PartnerAvailability {
  OFFLINE
  AVAILABLE
  BUSY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  PARTNER_ASSIGNED
  PARTNER_ARRIVING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
